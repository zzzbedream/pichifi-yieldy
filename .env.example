# Copy to `.env` (gitignored) and fill in. Never commit real values.

# --- Network (Robinhood Chain testnet, chain id 46630) ---
CHAIN_ID=46630
# Quicknode endpoint (HTTPS + WSS). Public fallback: https://rpc.testnet.chain.robinhood.com
RPC_URL=
WSS_URL=
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# --- Keys (testnet only; generate with `cast wallet new`) ---
# Deploys contracts and owns admin functions.
DEPLOYER_PRIVATE_KEY=
# Pays gas to relay signed intents (holds only ETH).
RELAYER_PRIVATE_KEY=
# Can pause / emergency-exit the vault. Keep this key off the agent server.
GUARDIAN_ADDRESS=
# Fallback intent signer (ECDSA verifier). Optional when BLS is used.
AGENT_ECDSA_PRIVATE_KEY=

# --- Amadeus agent identity (BLS12-381) ---
# Base58 64-byte seed from @amadeus-protocol/sdk generateKeypair()
AMADEUS_SEED_B58=
AMADEUS_NETWORK=testnet
AMADEUS_ANCHOR_ENABLED=true

# --- Deployed contracts (filled from deployments/robinhood-testnet.json) ---
VAULT_ADDRESS=
FEE_ENGINE_ADDRESS=
VERIFIER_ADDRESS=
ADAPTER_ADDRESS=
USDG_ADDRESS=
STOCK_TOKEN_ADDRESS=
ORACLE_ADDRESS=

# --- Agent API ---
AGENT_PORT=8787
# Bearer token for POST /scenario (demo controls)
DEMO_API_TOKEN=
# HMAC secret configured in the Quicknode Stream/Webhook
QUICKNODE_WEBHOOK_SECRET=
CORS_ORIGIN=http://localhost:3000

# --- Frontend (public) ---
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8787
# Hosted demo: origin the dashboard proxies /agent/* and /rpc to (build time, server-only), e.g. https://1-2-3-4.sslip.io
AGENT_ORIGIN=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_FEE_ENGINE_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=
NEXT_PUBLIC_ADAPTER_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
