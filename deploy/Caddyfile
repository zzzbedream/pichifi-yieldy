# HTTPS reverse proxy for the agent API (Let's Encrypt certificates are automatic).
# {$AGENT_DOMAIN} is substituted by scripts/bootstrap-vps.sh.
{$AGENT_DOMAIN} {
	encode gzip
	# Server-Sent Events must not be buffered.
	@stream path /stream
	reverse_proxy @stream 127.0.0.1:8787 {
		flush_interval -1
	}
	reverse_proxy 127.0.0.1:8787
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
